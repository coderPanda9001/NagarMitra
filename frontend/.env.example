# Vercel / Production Environment Variables Example
# Set these in your Vercel Project Settings -> Environment Variables

# Base URL for Backend API (Update to your live backend URL once deployed, e.g. https://your-backend.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to true if you want frontend to run in mock mode without backend server
VITE_USE_MOCK=false
